# ============================================================
# Neural Mesh v0.13 — COMPLETE TESTNET CONFIG
# Recommended profile: CPU node, ~16 cores / ~19 GB RAM, no GPU
# Zero-touch discovery, Full BFT, NRN, Evolution, Training/CAS/Explorer
# ============================================================

# -------------------------
# CORE / NETWORK
# -------------------------
PORT=48686
HOST=0.0.0.0
NETWORK_ID=neural-mesh-testnet-v7
DATA_DIR=./data

# Leave blank for zero-touch reachability detection.
PUBLIC_URL=
PRIVATE_NODE=false

# -------------------------
# ZERO-TOUCH DISCOVERY
# -------------------------
ZERO_TOUCH_ENABLED=true
MAINLINE_DHT_ENABLED=true
MAINLINE_DHT_ANNOUNCE=true
MAINLINE_DHT_HOST=0.0.0.0
MAINLINE_DHT_PORT=48686
MAINLINE_DHT_BOOTSTRAP=router.bittorrent.com:6881,dht.transmissionbt.com:6881,dht.libtorrent.org:25401
MAINLINE_LOOKUP_MS=120000
MAINLINE_QUERY_TIMEOUT_MS=2500
MAINLINE_ROUNDS=4
MAINLINE_ALPHA=6
MAINLINE_ANNOUNCE_NODES=12
MAINLINE_MAX_CANDIDATES=32
MAINLINE_DIAL_LIMIT=12
MAINLINE_ALLOW_PRIVATE_CANDIDATES=false
AUTO_REACHABILITY=true

# Normally blank: zero-touch finds the network automatically.
BOOTSTRAP_PEERS=
RELAY_PEERS=

RELAY_ENABLED=true
RELAY_POLL_MS=750

# LAN discovery is supplemental to Mainline DHT.
DISCOVERY_ENABLED=true
DISCOVERY_GROUP=239.255.86.86
DISCOVERY_PORT=48685

# Neural overlay DHT
DHT_K=20
DHT_ALPHA=3
DHT_REFRESH_MS=15000

# -------------------------
# SECURITY / API
# -------------------------
SECURITY_MODE=testnet

# Testnet: generated encrypted local secret is acceptable.
# Mainnet: set AUTO_LOCAL_SECRET=false and explicitly set passwords.
AUTO_LOCAL_SECRET=true
WALLET_PASSWORD=
NODE_KEY_PASSWORD=
ALLOW_INSECURE_KEYSTORE=false

# CHANGE THIS if the web/API port is reachable from another machine.
# Example: openssl rand -hex 32
API_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_64_HEX_TOKEN
ALLOW_UNAUTHENTICATED_LOCAL=true

# Blank = same-origin only. Do not use * on an Internet-facing node.
API_CORS_ORIGIN=

ADMISSION_POW_BITS=10
WORK_POW_BITS=8
ENVELOPE_MAX_SKEW_MS=300000
REPLAY_WINDOW_MS=600000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_API=120
RATE_LIMIT_P2P=600
MAX_BODY_BYTES=2000000

# -------------------------
# HARDWARE-AWARE LLM RUNTIME
# -------------------------
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_API_KEY=

# Automatically choose a model based on hardware.
AUTO_MODEL=true
MODEL_PROFILE=balanced
AUTO_MODEL_MAX=qwen3:4b
AUTO_INSTALL_OLLAMA=true
AUTO_INSTALL_RUNTIME=true
AUTO_INSTALL_GPU_RUNTIME=true
AUTO_PULL_MODEL=true
MODEL_SMOKE_TEST=true
MODEL_TEST_TIMEOUT_MS=300000

# Leave blank when AUTO_MODEL=true.
LLM_MODEL=

# Recommended for your ~16 CPU / ~19 GB RAM server.
LLM_THINK=false
LLM_NUM_CTX=2048
LLM_NUM_THREAD=8
LLM_TIMEOUT_MS=180000

# Simple greetings / short chat stay local and do not invoke full mesh synthesis.
CHAT_FAST_PATH=true

# Return the AI answer before NRN reward finality finishes.
CHAT_WAIT_REWARDS=false

P2P_TIMEOUT_MS=20000
MOCK_LLM=false

# Optional runtime diagnostics/overrides. Normally leave blank/zero.
HARDWARE_PROFILE=
DETECTED_RAM_MIB=0
DETECTED_CPU_CORES=0
DETECTED_GPU_COUNT=0
DETECTED_GPU_VRAM_MIB=0
MODEL_SELECTION_REASON=

# -------------------------
# NEURAL ROUTING
# -------------------------
CAPABILITIES=general,reasoning,critic,validator,code
MAX_REMOTE_WORKERS=3

# -------------------------
# NRN / WALLET
# -------------------------
# Optional: direct rewards from this node to a separate treasury wallet.
# Blank = local node wallet.
REWARD_ADDRESS=

REWARD_PER_SCORE=0.01
REWARD_WORKER_SHARE=0.80
REWARD_VALIDATOR_SHARE=0.15
REWARD_ROUTER_SHARE=0.05

TX_FEE_NRN=0.00000100
MAX_BLOCK_TX=100

# Recovery only. Normally leave blank after wallet creation.
WALLET_MNEMONIC=

# -------------------------
# VALIDATORS / STAKE / SLASHING
# -------------------------
VALIDATOR_ENABLED=true
VALIDATOR_COUNT=4
VALIDATOR_QUORUM=3

# For a persistent shared testnet, pin known genesis/bootstrap validator NodeIDs.
BOOTSTRAP_VALIDATOR_IDS=
AUTO_BOOTSTRAP_VALIDATORS=false
BOOTSTRAP_VALIDATOR_UNTIL_HEIGHT=1000

MIN_VALIDATOR_STAKE_NRN=0.00100000
SLASH_FRACTION=0.10
SLASH_JAIL_BLOCKS=100
ALLOW_SINGLE_VALIDATOR=false

# -------------------------
# v0.12/v0.13 FULL BFT CONSENSUS
# -------------------------
FULL_BFT_ENABLED=true

# Validator set is frozen per epoch.
VALIDATOR_EPOCH_BLOCKS=100

# Testnet delay. Mainnet should be much larger (e.g. 1000+).
UNBOND_DELAY_BLOCKS=10

# View-change / rounds
BFT_MAX_ROUNDS=4
BFT_ROUND_TIMEOUT_MS=8000
BFT_PREVOTE_TIMEOUT_MS=4000
BFT_PRECOMMIT_TIMEOUT_MS=4000

# Periodic ledger catch-up
LEDGER_SYNC_INTERVAL_MS=5000

# State checkpoints
SNAPSHOT_INTERVAL_BLOCKS=25
CHECKPOINT_QUORUM_ENABLED=true

# Testnet only: allow fast-sync from an unpinned but certified checkpoint.
ALLOW_UNTRUSTED_TESTNET_FAST_SYNC=true

# Mainnet: must be pinned to a trusted validator-set root before fast-sync.
TRUSTED_CHECKPOINT_VALIDATOR_ROOT=

# -------------------------
# LOCAL EVOLUTION ENGINE
# -------------------------
EVOLUTION_ENABLED=true
EVOLUTION_AUTO=true
EVOLUTION_LLM_PROPOSALS=true
EVOLUTION_ACCEPT_REMOTE=true

EVOLUTION_CANARY_SHARE=0.20
EVOLUTION_MIN_CANARY_SAMPLES=8
EVOLUTION_MAX_CANARY_SAMPLES=40
EVOLUTION_PROMOTION_MARGIN=0.02
EVOLUTION_MAX_ERROR_RATE=0.20
EVOLUTION_MIN_BENCHMARK_SCORE=0.75

EVOLUTION_AUTO_TASK_INTERVAL=20
EVOLUTION_IDLE_MS=120000
EVOLUTION_MIN_PROPOSAL_INTERVAL_MS=1800000
EVOLUTION_TICK_MS=60000

# Blank = automatically selected local model only.
EVOLUTION_MODEL_POOL=

# -------------------------
# COLLECTIVE EVOLUTION
# -------------------------
COLLECTIVE_EVOLUTION_ENABLED=true
COLLECTIVE_EVOLUTION_AUTO=true
COLLECTIVE_EVOLUTION_TICK_MS=30000
COLLECTIVE_EVOLUTION_EPOCH_MS=1800000
COLLECTIVE_EVOLUTION_VOTING_MS=300000

COLLECTIVE_EVOLUTION_MIN_VOTERS=2
COLLECTIVE_EVOLUTION_MAX_CANDIDATES=8
COLLECTIVE_EVOLUTION_MAX_PER_AUTHOR=2
COLLECTIVE_EVOLUTION_MAX_VOTE_WEIGHT=3
COLLECTIVE_EVOLUTION_ALLOW_UNSTAKED=true
COLLECTIVE_EVOLUTION_SPECIES_DISTANCE=0.18

# Collective winner must be BFT-anchored in ledger.
EVOLUTION_BFT_ANCHOR_ENABLED=true

# -------------------------
# CROSS-NODE KNOWLEDGE TRANSFER
# -------------------------
KNOWLEDGE_TRANSFER_ENABLED=true
KNOWLEDGE_AUTO_SHARE=true
KNOWLEDGE_MIN_QUALITY=0.72
KNOWLEDGE_MAX_CONTEXT=4
KNOWLEDGE_MAX_ARTIFACTS=5000

# -------------------------
# FEDERATED COGNITIVE LEARNING
# -------------------------
FEDERATED_LEARNING_ENABLED=true
FEDERATED_ROUND_MS=600000
FEDERATED_MIN_PARTICIPANTS=2
FEDERATED_MAX_WEIGHT=3

# -------------------------
# v0.10 NEURAL TRAINING / LoRA
# -------------------------
TRAINING_ENABLED=true

# Keep false on this CPU node; enable on a dedicated GPU/training node.
TRAINING_AUTO=false
TRAINING_MODE=auto
TRAINING_PYTHON=python3

TRAINING_MIN_ARTIFACTS=12
TRAINING_MAX_ARTIFACTS=128
TRAINING_MIN_QUALITY=0.80
TRAINING_INTERVAL_MS=21600000
TRAINING_TIMEOUT_MS=2700000
TRAINING_ADAPTER_DIR=./data/adapters

TRAINING_BASE_MODEL=Qwen/Qwen3-1.7B
TRAINING_OLLAMA_BASE_MODEL=qwen3:1.7b
TRAINING_EPOCHS=1
TRAINING_BATCH_SIZE=1
TRAINING_LEARNING_RATE=0.0002
TRAINING_LORA_RANK=8
TRAINING_LORA_ALPHA=16

TRAINING_SHARE_ADAPTERS=true
TRAINING_IMPORT_ADAPTERS=true
TRAINING_MAX_ADAPTER_BYTES=268435456
TRAINING_BENCHMARK_MIN_SCORE=0.70

# -------------------------
# v0.11 CONTENT-ADDRESSED MODEL NETWORK
# -------------------------
CONTENT_STORE_ENABLED=true
CONTENT_STORE_DIR=./data/content
CONTENT_REPLICATION_FACTOR=3
CONTENT_REPLICATION_INTERVAL_MS=120000
CONTENT_PROVIDER_TTL_MS=86400000
CONTENT_CHUNK_BYTES=262144
CONTENT_MAX_OBJECT_BYTES=536870912

# P2P backpressure so model/adapter replication does not starve chat/BFT.
P2P_MAX_INFLIGHT=8
P2P_PEER_MAX_INFLIGHT=2
P2P_BACKPRESSURE_TIMEOUT_MS=15000

# ============================================================
# MAINNET CHANGES (DO NOT ENABLE BLINDLY)
# ============================================================
# SECURITY_MODE=mainnet
# NETWORK_ID=neural-mesh-mainnet-v1
# AUTO_LOCAL_SECRET=false
# WALLET_PASSWORD=<strong secret>
# NODE_KEY_PASSWORD=<different strong secret>
# API_TOKEN=<64+ random hex chars>
# ADMISSION_POW_BITS=20
# WORK_POW_BITS=18
# UNBOND_DELAY_BLOCKS=1000
# SNAPSHOT_INTERVAL_BLOCKS=1000
# COLLECTIVE_EVOLUTION_MIN_VOTERS=4
# COLLECTIVE_EVOLUTION_ALLOW_UNSTAKED=false
# FEDERATED_MIN_PARTICIPANTS=4
# EVOLUTION_AUTO=false
# COLLECTIVE_EVOLUTION_AUTO=false
# TRAINING_AUTO=false
# AUTO_INSTALL_OLLAMA=false
# TRUSTED_CHECKPOINT_VALIDATOR_ROOT=<trusted root from genesis/release channel>
# ALLOW_UNTRUSTED_TESTNET_FAST_SYNC=false
