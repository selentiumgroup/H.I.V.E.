[Unit]
Description=Neural Mesh Node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=neuralmesh
Group=neuralmesh
WorkingDirectory=/opt/neural-mesh
EnvironmentFile=/etc/neural-mesh/node.env
ExecStart=/usr/bin/node /opt/neural-mesh/src/index.js
Restart=always
RestartSec=5
LimitNOFILE=1048576
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/neural-mesh /opt/neural-mesh/data

[Install]
WantedBy=multi-user.target
